# Supabase Cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inngest (deprecated - now using pg_cron)
# INNGEST_SIGNING_KEY=your-signing-key
# INNGEST_EVENT_KEY=your-event-key

# Modal (authenticated via CLI, no env var needed)

# ElevenLabs (Phase 3)
# ELEVENLABS_API_KEY=your-api-key

# OpenAI (for embeddings - required for pgvector migration)
OPENAI_API_KEY=your-api-key

# SuperMemory (deprecated - migrated to pgvector in Phase 8)
# SUPERMEMORY_API_KEY=your-api-key
