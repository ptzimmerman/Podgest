{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podgest-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 * * * *"
    ]
  }
}
