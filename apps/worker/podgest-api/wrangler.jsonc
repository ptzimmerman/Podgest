{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podgest-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Keep workers.dev URL active as fallback
  "workers_dev": true,
  // Note: Custom domain (api.podgest.app) is configured via Cloudflare dashboard
  // Cloudflare Queues for async digest processing
  // This decouples the cron trigger from the actual processing
  // Each user gets their own queue message with independent retry/timeout
  "queues": {
    "producers": [
      {
        "queue": "podgest-digest-queue",
        "binding": "DIGEST_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "podgest-digest-queue",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "podgest-digest-dlq"
      }
    ]
  },
  // Cloudflare-native data layer (Supabase migration, Jul 2026)
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "podgest-media"
    },
    {
      "binding": "TRANSCRIPTS",
      "bucket_name": "podgest-transcripts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podgest-db",
      "database_id": "f4f2c887-b593-42b8-9c27-2c485485e66e"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "podgest-vectors"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "16f342f38b6846409506e965e0c18ef1"
    }
  ],
  // Cron Triggers (replaced Supabase pg_cron, Jul 2026). All UTC.
  // poll feeds -> daily digest -> watchdog retries
  "triggers": {
    "crons": [
      "30 11 * * *",
      "0 12 * * *",
      "15,30 12 * * *",
      "45 12-16 * * *"
    ]
  }
}
