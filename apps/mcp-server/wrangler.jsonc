{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podgest-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  
  // Keep workers.dev URL active as fallback
  "workers_dev": true,
  // Note: Custom domain (mcp.podgest.app) is configured via Cloudflare dashboard
  
  // Environment variables (set via wrangler secret)
  // SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY, USER_ENCRYPTION_KEY
  
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "8dba0fed9c8544f8b6cbc93846695d8c"
    }
  ],
  
  "observability": {
    "enabled": true
  }
}
